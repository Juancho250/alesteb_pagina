# Public Storefront API base URL
VITE_API_BASE_URL=https://alesteb-back-1.onrender.com/public-api/v1

# Storefront publishable API key.
# IMPORTANT: every VITE_* value is embedded in the browser bundle.
# This key MUST be restricted server-side to the minimum storefront permissions
# and to the exact production/dev allowed origins. Never use an admin/private key here.
VITE_API_KEY=ak_<prefix>_<secret>
